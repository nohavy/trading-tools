<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<title>tradingv2 — état de la session paper</title>
<style>
body { font-family: system-ui, sans-serif; margin: 24px; color: #111; background: #fafafa; }
h1 { font-size: 20px; }
table { border-collapse: collapse; margin: 12px 0; }
td, th { border: 1px solid #ddd; padding: 4px 12px; font-size: 14px; }
th { background: #eee; text-align: left; }
.meta { font-size: 12px; color: #555; }
</style>
</head>
<body>
<h1>État de la session paper</h1>
<p class="meta">généré: {{ generated }}</p>
<table>
<tr><th>Jambe</th><th>Type</th><th>Trésorerie</th><th>Position</th>
    <th>Prix d'entrée</th><th>Equity</th><th>Dernière barre</th>
    <th>Dernier funding</th><th>Barres</th></tr>
{% for row in rows %}
<tr>
  <td>{{ row.name }}</td><td>{{ row.kind }}</td><td>{{ row.balance }}</td>
  <td>{{ row.position }}</td><td>{{ row.entry_price }}</td><td>{{ row.equity }}</td>
  <td>{{ row.last_close }}</td><td>{{ row.last_funding }}</td><td>{{ row.n_bars }}</td>
</tr>
{% endfor %}
</table>
<h2>Évolution de l'equity (marks daily)</h2>
<pre>{{ curves | tojson(indent=2) }}</pre>
</body>
</html>
